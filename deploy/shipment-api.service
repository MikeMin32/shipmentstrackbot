[Unit]
Description=Shipment Tracker API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
Group=YOUR_LINUX_USER
WorkingDirectory=/opt/shipment-bot/app
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/shipment-bot/app/.env
ExecStart=/opt/shipment-bot/app/.venv/bin/uvicorn api.main:create_app --factory --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

# Schema upgrades use an exclusive SQLite lock, so this unit and
# shipment-bot.service may start together without a required order.
# For the first production upgrade, stop both units, back up the DB,
# run: /opt/shipment-bot/app/.venv/bin/python -m database
# then start shipment-api and shipment-bot.

[Install]
WantedBy=multi-user.target
