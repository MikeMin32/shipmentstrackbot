# Example Nginx site for the Telegram Mini App.
# Replace YOUR_DOMAIN and certificate paths before use.
# Telegram Mini Apps require HTTPS in production.
#
# SPA routes such as /shipments/123 must fall back to index.html.
# /api/ is proxied to FastAPI. SQLite and .env are not under this root.

server {
    listen 80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    root /opt/shipment-bot/app/frontend/dist;
    index index.html;
    client_max_body_size 1m;

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        # No WebSocket upgrade: the API is plain HTTP.
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
