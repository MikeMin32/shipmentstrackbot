BOT_TOKEN=123456:ABC-DEF
ALLOWED_USER_IDS=123456789,987654321
DATABASE_PATH=./data/shipments.db

# HTTPS origin of the Mini App (optional; bot workspace does not require it)
MINI_APP_URL=

# Application-local timezone used for "today" when marking delivered
APP_TIMEZONE=UTC

# production | development | test
ENVIRONMENT=production

# FastAPI bind address (keep 127.0.0.1 when Nginx proxies)
API_HOST=127.0.0.1
API_PORT=8000

# Optional: built Mini App directory served by FastAPI if Nginx is not used
FRONTEND_DIST=./frontend/dist

# Comma-separated browser origins allowed to call the API.
# Leave empty in production (Mini App is same-origin behind Nginx).
# Local Vite: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Reject Telegram initData older than this many seconds (default 24h)
INIT_DATA_MAX_AGE_SECONDS=86400

# Development-only auth bypass. Ignored when ENVIRONMENT=production.
DEV_AUTH_ENABLED=false
DEV_TELEGRAM_USER_ID=

# Unused: the Telegram workspace is always the primary UI
ENABLE_LEGACY_BOT_UI=false
